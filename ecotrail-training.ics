UID:ecotrail-20260930-rest@training.openai.local
DTSTAMP:20260925T125500Z
DTSTART;VALUE=DATE:20260930
DTEND;VALUE=DATE:20261001
SUMMARY:Repos - pas de football
DESCRIPTION:Semaine de reprise : pas de football afin d'eviter encore les f
 ortes torsions et changements de direction.
STATUS:CONFIRMED
SEQUENCE:0
END:VEVENT
